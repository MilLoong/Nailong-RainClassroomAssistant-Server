[Unit]
Description=Nailong RainClassroom direct HTTPS backend
Wants=network-online.target
After=network-online.target

[Service]
User=nailong-test
Group=nailong-test
WorkingDirectory=/opt/nailong-test
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/nailong-test/.venv/bin/python -m server.hosted --origin https://121.4.26.119 --state-dir /opt/nailong-test/.local-dev
Restart=always
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nailong-test/.local-dev

[Install]
WantedBy=multi-user.target
